# 3. โปรแกรมหลัก (Real-Time Application Loop)
# ==============================================================================
def main():
    cap = cv2.VideoCapture(0)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)

    if not cap.isOpened():
        print("❌ [Error] ไม่สามารถเปิดกล้อง Webcam ได้")
        input("กด Enter เพื่อปิด...")
        return

    analyzer = RealtimeGoldenAnalyzer()
    face_mesh = None

    if HAS_MEDIAPIPE:
        face_mesh = mp_face_mesh.FaceMesh(
            max_num_faces=1,
            refine_landmarks=True,
            min_detection_confidence=0.6,
            min_tracking_confidence=0.6
        )

    os.makedirs("saved_reports", exist_ok=True)
    window_name = "Golden Ratio Face Analyzer - Real-Time Clean Output"

    print("=" * 70)
    print("  🚀 ระบบวัดสัดส่วนทองคำใบหน้าแบบ Real-Time พร้อมใช้งาน (Clean Output):")
    print("  • ลบเครื่องหมาย ???? ออกเรียบร้อย แสดงผลภาษาอังกฤษอย่างคมชัด 100%")
    print("  • กดปุ่ม [S] เพื่อบันทึกภาพรายงานผลลงเครื่อง")
    print("  • กดปุ่ม [Q] เพื่อออกจากโปรแกรม")
    print("=" * 70)

    while True:
        success, frame = cap.read()
        if not success:
            break

        frame = cv2.flip(frame, 1)
        h, w, _ = frame.shape

        landmarks_pixel = None
        if HAS_MEDIAPIPE and face_mesh:
            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            res = face_mesh.process(rgb)
            if res.multi_face_landmarks:
                lm_list = res.multi_face_landmarks[0].landmark
                landmarks_pixel = [(int(lm.x * w), int(lm.y * h)) for lm in lm_list]

        analysis = analyzer.analyze(frame, landmarks_pixel)

        if analysis:
            frame = analyzer.draw_hud(frame, analysis)
        else:
            cv2.putText(frame, "Position Face in Center of Camera...", (50, 80),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 0, 255), 2, cv2.LINE_AA)

        cv2.imshow(window_name, frame)

        key = cv2.waitKey(30) & 0xFF
        if key != 255:
            ch = chr(key).lower() if key < 256 else ''
            if ch == 'q' or key == 27:
                break
            elif ch == 's':
                fn = f"saved_reports/golden_ratio_realtime_{int(time.time())}.jpg"
                cv2.imwrite(fn, frame)
                print(f"📸 บันทึกภาพรายงานผลสำเร็จที่: {fn}")

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
