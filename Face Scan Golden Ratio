def get_safe_cascade(filename):
    try:
        if hasattr(cv2, 'data') and hasattr(cv2.data, 'haarcascades'):
            path = os.path.join(cv2.data.haarcascades, filename)
            c = cv2.CascadeClassifier(path)
            if not c.empty():
                return c
    except Exception:
        pass

    local_dir = "cascades"
    local_path = os.path.join(local_dir, filename)
    if os.path.exists(local_path):
        c = cv2.CascadeClassifier(local_path)
        if not c.empty():
            return c

    os.makedirs(local_dir, exist_ok=True)
    url = f"https://raw.githubusercontent.com/opencv/opencv/master/data/haarcascades/{filename}"
    try:
        urllib.request.urlretrieve(url, local_path)
        c = cv2.CascadeClassifier(local_path)
        if not c.empty():
            return c
    except Exception:
        pass

    return None

PHI = (1 + math.sqrt(5)) / 2  # ค่าคงที่สัดส่วนทองคำ 1.618

# ==============================================================================
# 2. คลาสวิเคราะห์สัดส่วนใบหน้า Real-Time (Clean English Text Output)
# ==============================================================================
class RealtimeGoldenAnalyzer:
    def __init__(self):
        self.face_cascade = get_safe_cascade('haarcascade_frontalface_default.xml')

    def _dist(self, p1, p2):
        return math.hypot(p1[0] - p2[0], p1[1] - p2[1])

    def analyze(self, frame, landmarks_pixel=None):
        h, w, _ = frame.shape
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

        if landmarks_pixel and len(landmarks_pixel) >= 468:
            pts = {
                'forehead': landmarks_pixel[10],
                'chin': landmarks_pixel[152],
                'left_cheek': landmarks_pixel[234],
                'right_cheek': landmarks_pixel[454],
                'left_eye_outer': landmarks_pixel[33],
                'left_eye_inner': landmarks_pixel[133],
                'right_eye_inner': landmarks_pixel[362],
                'right_eye_outer': landmarks_pixel[263],
                'eyebrow_center': landmarks_pixel[9],
                'nose_top': landmarks_pixel[6],
                'nose_bottom': landmarks_pixel[2],
                'left_nose': landmarks_pixel[64],
                'right_nose': landmarks_pixel[294],
                'mouth_left': landmarks_pixel[61],
                'mouth_right': landmarks_pixel[291],
                'upper_lip_top': landmarks_pixel[0],
                'upper_lip_bot': landmarks_pixel[13],
                'lower_lip_top': landmarks_pixel[14],
                'lower_lip_bot': landmarks_pixel[17]
            }
        else:
            # OpenCV Dynamic Feature Extractor Real-Time
            fx, fy, fw, fh = int(w * 0.35), int(h * 0.22), int(w * 0.3), int(h * 0.52)
            if self.face_cascade is not None and not self.face_cascade.empty():
                faces = self.face_cascade.detectMultiScale(gray, 1.2, 4)
                if len(faces) > 0:
                    (fx, fy, fw, fh) = faces[0]

            # ตรวจจับตำแหน่งตาจริงจากม่านตามืด
            eye_roi = gray[fy + int(fh*0.2):fy + int(fh*0.45), fx:fx + fw]
            left_e_x, right_e_x = int(fw * 0.3), int(fw * 0.7)
            eye_y = int(fh * 0.35)

            if eye_roi.size > 0:
                h_roi, w_roi = eye_roi.shape
                l_part = eye_roi[:, :w_roi//2]
                r_part = eye_roi[:, w_roi//2:]
                if l_part.size > 0 and r_part.size > 0:
                    _, _, min_l, _ = cv2.minMaxLoc(l_part)
                    _, _, min_r, _ = cv2.minMaxLoc(r_part)
                    left_e_x = min_l[0]
                    right_e_x = w_roi//2 + min_r[0]
                    eye_y = int(fh * 0.2) + (min_l[1] + min_r[1]) // 2

            # ตรวจจับริมฝีปากจริงจากสเปกตรัมสี HSV
            hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
            mouth_roi = hsv[fy + int(fh*0.65):fy + int(fh*0.9), fx + int(fw*0.2):fx + int(fw*0.8)]
            m_lx, m_rx, mouth_y = int(fw * 0.32), int(fw * 0.68), int(fh * 0.78)

            if mouth_roi.size > 0:
                m1 = cv2.inRange(mouth_roi, np.array([0, 35, 35]), np.array([15, 255, 255]))
                m2 = cv2.inRange(mouth_roi, np.array([160, 35, 35]), np.array([180, 255, 255]))
                cnts, _ = cv2.findContours(m1 | m2, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
                if cnts:
                    c = max(cnts, key=cv2.contourArea)
                    mx, my, mw_box, mh_box = cv2.boundingRect(c)
                    if mw_box > 10:
                        m_lx = int(fw * 0.2) + mx
                        m_rx = int(fw * 0.2) + mx + mw_box
                        mouth_y = int(fh * 0.65) + my + mh_box // 2

            pts = {
                'forehead': (fx + fw // 2, fy),
                'chin': (fx + fw // 2, fy + fh),
                'left_cheek': (fx, fy + int(fh * 0.55)),
                'right_cheek': (fx + fw, fy + int(fh * 0.55)),
                'left_eye_outer': (fx + max(0, left_e_x - int(fw * 0.1)), fy + eye_y),
                'left_eye_inner': (fx + left_e_x + int(fw * 0.05), fy + eye_y),
                'right_eye_inner': (fx + right_e_x - int(fw * 0.05), fy + eye_y),
                'right_eye_outer': (fx + min(fw, right_e_x + int(fw * 0.1)), fy + eye_y),
                'eyebrow_center': (fx + fw // 2, fy + int(fh * 0.3)),
                'nose_top': (fx + fw // 2, fy + int(fh * 0.35)),
                'nose_bottom': (fx + fw // 2, fy + int(fh * 0.62)),
                'left_nose': (fx + int(fw * 0.38), fy + int(fh * 0.62)),
                'right_nose': (fx + int(fw * 0.62), fy + int(fh * 0.62)),
                'mouth_left': (fx + m_lx, fy + mouth_y),
                'mouth_right': (fx + m_rx, fy + mouth_y),
                'upper_lip_top': (fx + fw // 2, fy + mouth_y - 8),
                'upper_lip_bot': (fx + fw // 2, fy + mouth_y - 2),
                'lower_lip_top': (fx + fw // 2, fy + mouth_y + 2),
                'lower_lip_bot': (fx + fw // 2, fy + mouth_y + 10),
            }

        # ----------------------------------------------------------------------
        # การวัดสัดส่วนทองคำมาตรฐานโลก (Target: 1.618)
        # ----------------------------------------------------------------------
        face_h = self._dist(pts['forehead'], pts['chin'])
        face_w = self._dist(pts['left_cheek'], pts['right_cheek'])
        r_face = face_h / face_w if face_w > 0 else PHI

        mouth_w = self._dist(pts['mouth_left'], pts['mouth_right'])
        nose_w = self._dist(pts['left_nose'], pts['right_nose'])
        r_mn = mouth_w / nose_w if nose_w > 0 else PHI

        e_gap = self._dist(pts['left_eye_inner'], pts['right_eye_inner'])
        e_w1 = self._dist(pts['left_eye_outer'], pts['left_eye_inner'])
        e_w2 = self._dist(pts['right_eye_inner'], pts['right_eye_outer'])
        avg_ew = (e_w1 + e_w2) / 2.0
        r_eye = e_gap / avg_ew if avg_ew > 0 else 1.0

        nose_chin = self._dist(pts['nose_bottom'], pts['chin'])
        mouth_chin = self._dist(pts['upper_lip_top'], pts['chin'])
        r_nmc = nose_chin / mouth_chin if mouth_chin > 0 else PHI

        u_lip = self._dist(pts['upper_lip_top'], pts['upper_lip_bot'])
        l_lip = self._dist(pts['lower_lip_top'], pts['lower_lip_bot'])
        r_lip = l_lip / u_lip if u_lip > 0 else PHI

        t1 = self._dist(pts['forehead'], pts['eyebrow_center'])
        t2 = self._dist(pts['eyebrow_center'], pts['nose_bottom'])
        t3 = self._dist(pts['nose_bottom'], pts['chin'])
        total_t = t1 + t2 + t3
        s1 = (t1 / total_t) * 3 if total_t > 0 else 1
        s2 = (t2 / total_t) * 3 if total_t > 0 else 1
        s3 = (t3 / total_t) * 3 if total_t > 0 else 1
        thirds_score = max(0.0, 100.0 - (abs(s1 - 1) + abs(s2 - 1) + abs(s3 - 1)) * 33.3)

        def calc_score(val, target=PHI):
            diff = abs(val - target) / target
            return max(0.0, min(100.0, (1.0 - diff) * 100.0))

        sc_face = calc_score(r_face, PHI)
        sc_mn = calc_score(r_mn, PHI)
        sc_nmc = calc_score(r_nmc, PHI)
        sc_lip = calc_score(r_lip, PHI)
        sc_eye = calc_score(r_eye, 1.0)
        sc_thirds = thirds_score

        overall = (sc_face * 0.25 + sc_mn * 0.20 + sc_nmc * 0.20 + sc_lip * 0.15 + sc_eye * 0.10 + sc_thirds * 0.10)

        # ----------------------------------------------------------------------
        # การจำแนกลักษณะใบหน้าภาษาอังกฤษล้วน (Clean English Text Output)
        # ----------------------------------------------------------------------
        if r_face > 1.68:
            face_shape = "Slender Golden Oval"
        elif r_face < 1.45:
            face_shape = "Round / Square Face"
        else:
            face_shape = "Ideal Golden Oval"

        forehead_ratio = t1 / total_t if total_t > 0 else 0.33
        if forehead_ratio > 0.36:
            forehead_shape = "Broad High Forehead"
        elif forehead_ratio < 0.29:
            forehead_shape = "Narrow Forehead"
        else:
            forehead_shape = "Golden Forehead"

        if r_eye > 1.15:
            eye_shape = "Wide Almond Eyes"
        elif r_eye < 0.88:
            eye_shape = "Slender Symmetric Eyes"
        else:
            eye_shape = "Golden Almond Eyes"

        nose_len = self._dist(pts['nose_top'], pts['nose_bottom'])
        r_nose_shape = nose_len / nose_w if nose_w > 0 else 1.5
        if r_nose_shape > 1.65:
            nose_shape = "Slender High Nose"
        elif r_nose_shape < 1.3:
            nose_shape = "Natural Broad Nose"
        else:
            nose_shape = "Ideal Golden Nose"

        if r_mn > 1.72:
            lip_shape = "Wide Attractive Lips"
        elif r_mn < 1.48:
            lip_shape = "Full Compact Lips"
        else:
            lip_shape = "Golden Ratio Lips"

        chin_ratio = t3 / total_t if total_t > 0 else 0.33
        if chin_ratio > 0.36:
            chin_shape = "V-Line Chin"
        elif chin_ratio < 0.29:
            chin_shape = "Soft Round Chin"
        else:
            chin_shape = "Golden Ratio Chin"

        return {
            'pts': pts,
            'ratios': {'face': r_face, 'mn': r_mn, 'nmc': r_nmc, 'lip': r_lip, 'eye': r_eye},
            'scores': {'face': sc_face, 'mn': sc_mn, 'nmc': sc_nmc, 'lip': sc_lip, 'eye': sc_eye, 'thirds': sc_thirds, 'overall': overall},
            'classifications': {
                'face_shape': face_shape,
                'forehead_shape': forehead_shape,
                'eye_shape': eye_shape,
                'nose_shape': nose_shape,
                'lip_shape': lip_shape,
                'chin_shape': chin_shape
            }
        }

    def draw_hud(self, img, analysis):
        pts = analysis['pts']
        sc = analysis['scores']
        ra = analysis['ratios']
        cls = analysis['classifications']

        GOLD = (0, 215, 255)
        CYAN = (255, 230, 0)
        GREEN = (0, 255, 128)
        WHITE = (240, 240, 240)
        DARK_BG = (15, 15, 25)

        # วาดเส้นสัดส่วนทองคำบนใบหน้า Real-Time
        cv2.line(img, pts['forehead'], pts['chin'], CYAN, 2, cv2.LINE_AA)
        cv2.line(img, pts['left_cheek'], pts['right_cheek'], GOLD, 2, cv2.LINE_AA)
        cv2.line(img, pts['left_eye_outer'], pts['right_eye_outer'], GOLD, 1, cv2.LINE_AA)
        cv2.line(img, pts['left_nose'], pts['right_nose'], GOLD, 1, cv2.LINE_AA)
        cv2.line(img, pts['mouth_left'], pts['mouth_right'], GOLD, 1, cv2.LINE_AA)

        for pt in pts.values():
            cv2.circle(img, pt, 4, GREEN, -1, cv2.LINE_AA)
            cv2.circle(img, pt, 6, GOLD, 1, cv2.LINE_AA)

        # แผงวิเคราะห์ย่อย Real-Time ด้านขวา
        h, w, _ = img.shape
        pw = 450
        overlay = img.copy()
        cv2.rectangle(overlay, (w - pw, 0), (w, h), DARK_BG, -1)
        cv2.addWeighted(overlay, 0.85, img, 0.15, 0, img)
        cv2.line(img, (w - pw, 0), (w - pw, h), GOLD, 2)

        x = w - pw + 25
        y = 35

        cv2.putText(img, "REAL-TIME GOLDEN RATIO ANALYZER", (x, y), cv2.FONT_HERSHEY_SIMPLEX, 0.55, GOLD, 2, cv2.LINE_AA)
        cv2.putText(img, "INTERNATIONAL AESTHETICS (PHI = 1.618)", (x, y + 22), cv2.FONT_HERSHEY_SIMPLEX, 0.38, CYAN, 1, cv2.LINE_AA)

        y += 55
        overall = sc['overall']
        score_clr = GREEN if overall >= 80 else (0, 200, 255) if overall >= 65 else (0, 100, 255)

        cv2.rectangle(img, (x, y - 5), (w - 25, y + 50), (30, 30, 50), cv2.FILLED)
        cv2.rectangle(img, (x, y - 5), (w - 25, y + 50), score_clr, 1)
        cv2.putText(img, "GOLDEN BEAUTY SCORE", (x + 15, y + 18), cv2.FONT_HERSHEY_SIMPLEX, 0.45, (200, 200, 200), 1, cv2.LINE_AA)
        cv2.putText(img, f"{overall:.1f} %", (x + 250, y + 38), cv2.FONT_HERSHEY_SIMPLEX, 1.1, score_clr, 3, cv2.LINE_AA)

        y += 75
        cv2.putText(img, "=== FACIAL FEATURE CLASSIFICATIONS ===", (x, y), cv2.FONT_HERSHEY_SIMPLEX, 0.40, CYAN, 1, cv2.LINE_AA)
        y += 20

        features = [
            ("Face Shape", cls['face_shape']),
            ("Forehead", cls['forehead_shape']),
            ("Eyes", cls['eye_shape']),
            ("Nose", cls['nose_shape']),
            ("Lips & Mouth", cls['lip_shape']),
            ("Chin & Jaw", cls['chin_shape']),
        ]

        for title, desc in features:
            cv2.putText(img, f"• {title}:", (x, y), cv2.FONT_HERSHEY_SIMPLEX, 0.40, GOLD, 1, cv2.LINE_AA)
            cv2.putText(img, desc, (x + 110, y), cv2.FONT_HERSHEY_SIMPLEX, 0.40, WHITE, 1, cv2.LINE_AA)
            y += 24

        y += 10
        cv2.putText(img, "=== GOLDEN RATIO METRICS (TARGET: 1.618) ===", (x, y), cv2.FONT_HERSHEY_SIMPLEX, 0.40, CYAN, 1, cv2.LINE_AA)
        y += 22

        metrics = [
            ("Face Height/Width", ra['face'], sc['face'], 1.618),
            ("Mouth/Nose Width", ra['mn'], sc['mn'], 1.618),
            ("Nose-Chin/Mouth-Chin", ra['nmc'], sc['nmc'], 1.618),
            ("Lower/Upper Lip", ra['lip'], sc['lip'], 1.618),
            ("Eye Gap/Eye Width", ra['eye'], sc['eye'], 1.000),
            ("Facial Thirds Symmetry", sc['thirds'] / 100.0 * 1.618, sc['thirds'], 1.000)
        ]

        for name, val, score_val, target in metrics:
            cv2.putText(img, name, (x, y), cv2.FONT_HERSHEY_SIMPLEX, 0.38, WHITE, 1, cv2.LINE_AA)
            cv2.putText(img, f"{val:.2f} ({score_val:.0f}%)", (x + 220, y), cv2.FONT_HERSHEY_SIMPLEX, 0.36, GOLD, 1, cv2.LINE_AA)

            y += 6
            bw = 390
            fw = int(bw * (score_val / 100.0))
            cv2.rectangle(img, (x, y), (x + bw, y + 6), (40, 40, 60), -1)
            cv2.rectangle(img, (x, y), (x + fw, y + 6), score_clr, -1)
            y += 22

        cv2.putText(img, "PRESS [S] SAVE REPORT  |  PRESS [Q] QUIT", (x, h - 20),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.42, CYAN, 1, cv2.LINE_AA)
        return img

