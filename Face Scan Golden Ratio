def get_safe_cascade(filename):
    try:
        if hasattr(cv2, 'data') and hasattr(cv2.data, 'haarcascades'):
            path = os.path.join(cv2.data.haarcascades, filename)
            c = cv2.CascadeClassifier(path)
            if not c.empty():
                return c
    except Exception:
        pass

    local_dir = "cascades"
    local_path = os.path.join(local_dir, filename)
    if os.path.exists(local_path):
        c = cv2.CascadeClassifier(local_path)
        if not c.empty():
            return c

    os.makedirs(local_dir, exist_ok=True)
    url = f"https://raw.githubusercontent.com/opencv/opencv/master/data/haarcascades/{filename}"
    try:
        urllib.request.urlretrieve(url, local_path)
        c = cv2.CascadeClassifier(local_path)
        if not c.empty():
            return c
    except Exception:
        pass

    return None

PHI = (1 + math.sqrt(5)) / 2  # ค่าคงที่สัดส่วนทองคำ 1.618


# ==============================================================================
# 2. ตัวช่วย Smoothing (ลดอาการสั่น/กระตุกของจุดสัดส่วน)
# ==============================================================================
class PointSmoother:
    """Exponential Moving Average — ทำให้จุดต่างๆ นิ่งขึ้นแต่ยังตามการขยับหน้าได้ทัน"""

    def __init__(self, alpha=0.45):
        self.alpha = alpha
        self.state = {}

    def smooth(self, pts):
        out = {}
        for key, (x, y) in pts.items():
            if key in self.state:
                px, py = self.state[key]
                nx = px + self.alpha * (x - px)
                ny = py + self.alpha * (y - py)
            else:
                nx, ny = x, y
            out[key] = (int(nx), int(ny))
            self.state[key] = (nx, ny)
        return out

    def reset(self):
        self.state = {}


