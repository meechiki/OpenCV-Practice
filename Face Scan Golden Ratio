# 4. โปรแกรมหลัก (Real-Time Application Loop)
# ==============================================================================
def main():
    parser = argparse.ArgumentParser(description="Real-Time Golden Ratio Face Analyzer")
    parser.add_argument("--camera", type=int, default=0, help="Camera index (default: 0)")
    parser.add_argument("--width", type=int, default=1280)
    parser.add_argument("--height", type=int, default=720)
    parser.add_argument("--detect-every", type=int, default=5,
                         help="ตรวจจับใบหน้าใหม่ทุกกี่เฟรม เมื่อไม่มี MediaPipe (ค่ายิ่งสูง = เร็วขึ้นแต่ตอบสนองช้าลง)")
    args = parser.parse_args()

    cap = cv2.VideoCapture(args.camera)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, args.width)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, args.height)

    if not cap.isOpened():
        print(f"❌ [Error] ไม่สามารถเปิดกล้อง Webcam (index={args.camera}) ได้")
        print("   ลองตรวจสอบว่ามีโปรแกรมอื่นใช้กล้องอยู่หรือไม่ หรือลองเปลี่ยน --camera 1")
        input("กด Enter เพื่อปิด...")
        return

    analyzer = RealtimeGoldenAnalyzer(detect_every_n_frames=args.detect_every)
    smoother = PointSmoother(alpha=0.45)
    face_mesh = None

    if HAS_MEDIAPIPE:
        try:
            face_mesh = mp_face_mesh.FaceMesh(
                max_num_faces=1,
                refine_landmarks=True,
                min_detection_confidence=0.6,
                min_tracking_confidence=0.6
            )
        except Exception as e:
            print(f"[Warning] เปิด MediaPipe FaceMesh ไม่สำเร็จ ({e}) — ใช้ Haar Cascade แทน")
            face_mesh = None

    window_name = "Golden Ratio Face Analyzer v2 - Real-Time"

    print("=" * 70)
    print("  🚀 ระบบวัดสัดส่วนทองคำใบหน้าแบบ Real-Time (v2 - Optimized):")
    print("  • ตรวจจับใบหน้าไม่เจอ = แจ้งเตือนจริง ไม่เดาตำแหน่งมั่ว")
    print("  • มี Point Smoothing ลดอาการสั่นของจุดวัด")
    print("  • Haar Cascade ไม่ต้องรันทุกเฟรม -> เร็วขึ้น")
    print("  • กด [S] บันทึกภาพ + ข้อมูล JSON | กด [Q] ออกจากโปรแกรม")
    print("=" * 70)

    prev_time = time.time()
    fps = 0.0

    try:
        while True:
            success, frame = cap.read()
            if not success:
                print("⚠️  [Warning] อ่านเฟรมจากกล้องไม่สำเร็จ กำลังลองใหม่...")
                time.sleep(0.05)
                continue

            frame = cv2.flip(frame, 1)
            h, w, _ = frame.shape

            landmarks_pixel = None
            if face_mesh is not None:
                rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                rgb.flags.writeable = False
                res = face_mesh.process(rgb)
                if res.multi_face_landmarks:
                    lm_list = res.multi_face_landmarks[0].landmark
                    landmarks_pixel = [(int(lm.x * w), int(lm.y * h)) for lm in lm_list]

            analysis = analyzer.analyze(frame, landmarks_pixel)

            # คำนวณ FPS แบบ smoothed
            now = time.time()
            inst_fps = 1.0 / max(1e-6, (now - prev_time))
            fps = fps * 0.9 + inst_fps * 0.1
            prev_time = now

            if analysis:
                analysis['pts'] = smoother.smooth(analysis['pts'])
                frame = analyzer.draw_hud(frame, analysis, fps=fps)
            else:
                smoother.reset()
                cv2.putText(frame, "Position Face in Center of Camera...", (50, 80),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 0, 255), 2, cv2.LINE_AA)
                cv2.putText(frame, f"FPS: {fps:.1f}", (50, 120),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 200, 255), 2, cv2.LINE_AA)

            cv2.imshow(window_name, frame)

            key = cv2.waitKey(1) & 0xFF
            if key != 255:
                ch = chr(key).lower() if key < 256 else ''
                if ch == 'q' or key == 27:
                    break
                elif ch == 's':
                    if analysis:
                        img_path, json_path = save_report(frame, analysis)
                        print(f"📸 บันทึกสำเร็จ: {img_path}")
                        print(f"📄 ข้อมูลตัวเลข: {json_path}")
                    else:
                        print("⚠️  ยังไม่เจอใบหน้า ไม่สามารถบันทึกได้")

    except KeyboardInterrupt:
        print("\n[Info] หยุดโปรแกรมโดยผู้ใช้ (Ctrl+C)")
    finally:
        cap.release()
        cv2.destroyAllWindows()
        if face_mesh is not None:
            try:
                face_mesh.close()
            except Exception:
                pass
        print("[Info] ปิดโปรแกรมเรียบร้อย")


if __name__ == "__main__":
    main()
